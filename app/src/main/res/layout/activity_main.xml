<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:gravity="center"
    android:padding="32dp"
    android:background="@color/luci_rosa_suave">

    <!-- Logo de Lucimakeup -->
    <ImageView
        android:id="@+id/ivLogoBienvenida"
        android:layout_width="130dp"
        android:layout_height="130dp"
        android:src="@drawable/ic_logo_lucimakeup"
        android:contentDescription="Logo Lucimakeup"
        android:layout_marginBottom="24dp"/>

    <!-- Título de Marca -->
    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="LUCIMAKEUP"
        android:textSize="30sp"
        android:textStyle="bold"
        android:letterSpacing="0.1"
        android:textColor="@color/luci_rosa_principal"
        android:layout_marginBottom="8dp"/>

    <!-- Mensaje de Bienvenida -->
    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="¡Bienvenidos!"
        android:textSize="22sp"
        android:textStyle="bold"
        android:textColor="@color/luci_texto_oscuro"
        android:layout_marginBottom="12dp"/>

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Descubre tu esencia con nuestra colección exclusiva de maquillaje y cuidado facial."
        android:textAlignment="center"
        android:textSize="15sp"
        android:textColor="@color/luci_texto_gris"
        android:layout_marginBottom="40dp"/>

    <!-- Botón Siguiente -->
    <Button
        android:id="@+id/btnSiguiente"
        android:layout_width="match_parent"
        android:layout_height="54dp"
        android:text="SIGUIENTE"
        android:textSize="16sp"
        android:textStyle="bold"
        android:backgroundTint="@color/luci_rosa_principal"
        android:textColor="@color/luci_blanco"/>

</LinearLayout>
