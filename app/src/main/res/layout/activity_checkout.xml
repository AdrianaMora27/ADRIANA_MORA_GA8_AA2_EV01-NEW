<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/luci_rosa_suave"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="20dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Formulario de Envío y Pago"
            android:textSize="22sp"
            android:textStyle="bold"
            android:textColor="@color/luci_rosa_principal"
            android:layout_marginBottom="16dp"/>

        <EditText
            android:id="@+id/etNombreEnvio"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:hint="Nombre completo"
            android:background="@color/luci_blanco"
            android:padding="12dp"
            android:layout_marginBottom="12dp"/>

        <EditText
            android:id="@+id/etDireccionEnvio"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:hint="Dirección de entrega (Cali)"
            android:background="@color/luci_blanco"
            android:padding="12dp"
            android:layout_marginBottom="12dp"/>

        <EditText
            android:id="@+id/etTelefonoEnvio"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:hint="Teléfono de contacto"
            android:inputType="phone"
            android:background="@color/luci_blanco"
            android:padding="12dp"
            android:layout_marginBottom="20dp"/>

        <Button
            android:id="@+id/btnConfirmarPedido"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:text="CONFIRMAR PEDIDO EXITOSO"
            android:textStyle="bold"
            android:backgroundTint="@color/luci_rosa_oscuro"
            android:textColor="@color/luci_blanco"/>

    </LinearLayout>
</ScrollView>
